    name = "foo",
    srcs = ["Foo.kt"],
    visibility = ["//visibility:public"],
    deps = ["@maven//:org_json_json"],
)

kt_jvm_test(
    name = "foo_test",
    srcs = ["FooTest.kt"],
    test_class = "com.geekinasuit.agency.foo.FooTest",
    deps = [
        ":foo",
        "@maven//:junit_junit",
        "@maven//:org_json_json",
    ],
)

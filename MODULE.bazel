# The declared version is the NEXT release's number — bumped here ahead of tagging, and
# scripts/release.main.kts refuses to release a tag that does not match it.
module(
    name = "agency",
    version = "0.1.1",
    # REPO.bazel uses ignore_directories(), a Bazel 8+ API; without this a Bazel 7
    # consumer gets a Starlark name error inside this module instead of a version message.
    bazel_compatibility = [">=8.0.0"],
)

bazel_dep(name = "bazel_skylib", version = "1.8.2")
bazel_dep(name = "rules_kotlin", version = "2.1.9")
bazel_dep(name = "rules_jvm_external", version = "6.8")

# JVM-17 Kotlin toolchain (rules_kotlin's default targets 1.8).
register_toolchains("//bazel/kotlin:kotlin_toolchain")

maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")
maven.install(
    name = "maven",
    artifacts = [
        "junit:junit:4.13.2",
        "org.json:json:20240303",
        # Same pins as the consuming module: any artifact both modules request must stay
        # same-version on both sides until a deliberate skew probe says otherwise.
        "org.jetbrains.kotlinx:kotlinx-serialization-core-jvm:1.8.1",
        "org.jetbrains.kotlinx:kotlinx-serialization-json-jvm:1.8.1",
        "org.xerial:sqlite-jdbc:3.46.1.3",
        # ACP Kotlin SDK (the pod layer's transport, agency/pod). KMP publication note:
        # the bare `acp` coordinate is a metadata stub (.knm, no classes); the -jvm
        # artifact carries the real JVM jar and a clean all-jvm POM chain. Pre-1.0: pin
        # exact, bump deliberately. acp-model-jvm rides in transitively at the same
        # version (BUILD files reference its generated label directly).
        # BUMP CONSTRAINTS: (a) acp-jvm is built with Kotlin 2.2, so this universe's
        # kotlin-stdlib resolves 2.2.20 while the rules_kotlin toolchain compiles at
        # 2.1.21 — the outer edge of kotlinc's read-one-minor-ahead metadata window; an
        # acp release built with Kotlin 2.3 breaks every consumer until the toolchain
        # moves. (b) acp's transitives (kotlin-logging, kotlinx-io, atomicfu, stdlib)
        # are NOT pinned and float universe-wide — every acp bump therefore owes a
        # resolved-coordinates diff (bazel query @maven//:all --output=build,
        # coordinates extracted, before vs after), not just green tests.
        "com.agentclientprotocol:acp-jvm:0.26.0",
        # Coroutines: acp-jvm requires the 1.9.x family, and one universe must resolve
        # exactly one family — the standing guard in agency/pod
        # (acp_single_coroutines_family_test) pins the exact reachable label set
        # (AGENCY-027 discipline).
        "org.jetbrains.kotlinx:kotlinx-coroutines-core:1.9.0",
        # slf4j-api: RUNTIME need of acp-jvm's kotlin-logging-jvm 7.x, whose POM does
        # not surface it — without it StdioTransport's <clinit> dies
        # (NoClassDefFoundError: org/slf4j/LoggerFactory). API-only on purpose: no
        # provider bound, so SLF4J no-ops and SDK trace logging stays out of pod
        # substrate output.
        "org.slf4j:slf4j-api:2.0.16",
        # libsecp256k1 bindings: BIP-340 schnorr sign/verify and ECDH, the primitives the
        # authorization layer's signed-event surface is built from. Apache-2.0.
        #
        # WHY THIS AND NOT A NOSTR LIBRARY: the one mature Kotlin nostr library on Maven
        # (com.vitorpamplona.quartz:quartz-jvm) declares kotlin-stdlib 2.4.10 — two minors
        # past even the outer edge of the read-one-minor-ahead window described above — and
        # pulls androidx, a Compose runtime artifact, a second JSON stack, and coroutines
        # and serialization versions that collide with the pins above. So the event codec
        # is ours and thin, over these primitives. Re-evaluate quartz only if the toolchain
        # moves far enough to read its metadata.
        #
        # BUMP CONSTRAINT: 0.19.0 declares kotlin-stdlib 2.1.21, an exact match to the
        # toolchain, so its metadata needs no forward-read at all. 0.20.0 through 0.22.0
        # declare 2.2.x and would sit at the same outer edge acp-jvm already occupies;
        # 0.23.0 declares 2.3.10 and is outside the window. Nothing we need arrived after
        # 0.19.0, so the exact-match release is the pin rather than the newest readable one.
        "fr.acinq.secp256k1:secp256k1-kmp-jvm:0.19.0",
        # The natives. -jni-jvm is an aggregate whose POM pulls all three platform jars
        # (darwin, linux, mingw ~ 6.2 MB total), and the loader picks the matching library
        # off the classpath at runtime — so ONE coordinate covers every platform and no
        # per-platform select() is needed.
        #
        # NOT -jni-jvm-extract, which is the loader ONLY and ships no libraries: pinning it
        # alone resolves and compiles cleanly and then fails at first use with "No native
        # library found: /fr/acinq/secp256k1/jni/native/darwin/libsecp256k1-jni.dylib". That
        # failure mode — green resolution, green compile, dead at runtime — is why the probe
        # in agency/crypto runs the primitives rather than only building against them.
        #
        # This is the module's only JNI dependency; see agency/crypto/BUILD.bazel for what it
        # costs an adopter and what the pure-JVM exit would be.
        "fr.acinq.secp256k1:secp256k1-kmp-jni-jvm:0.19.0",
    ],
    version_conflict_policy = "pinned",
    repositories = [
        "https://repo1.maven.org/maven2",
    ],
)
use_repo(maven, "maven")

    main_class = "com.geekinasuit.agency.wiring.ApprovalTool",
    runtime_deps = [
        ":wiring",
        "@maven//:fr_acinq_secp256k1_secp256k1_kmp_jni_jvm",
    ],
)

kt_jvm_test(

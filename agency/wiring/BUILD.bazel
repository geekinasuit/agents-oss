load("@bazel_skylib//rules:common_settings.bzl", "string_flag")
load("@rules_kotlin//kotlin:jvm.bzl", "kt_jvm_library", "kt_jvm_test")
load(":pinned_root.bzl", "pinned_root_jar")

# Wiring: the adapters that join the lead host to the nostr substrate. Neither side depends on the
# other (the lead never sees a nostr type; nostr never sees the host), so the pieces that need both
# live here, and a deployment links them from here.

kt_jvm_library(
    name = "wiring",
    srcs = [
        # Carries approvals from a relay to the host's accept boundary.
        "ApprovalIngress.kt",
        # The approver's tool (approval below).
        "ApprovalTool.kt",
        # The operator's spec tool (auth_spec below).
        "AuthSpecTool.kt",
        # Key files and flags, shared by the operator's tools.
        "KeyFiles.kt",
        # The auth a lead folds under, from its signed spec file and pinned root.
        "LeadAuthFiles.kt",
        # The operator's status tool (lead_status below).
        "LeadStatusTool.kt",
        "NostrGateOpenSink.kt",
        # A ticket lead with no model in it (scripted_lead below).
        "ScriptedLeadRunner.kt",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//agency/lead",
        "//agency/lead:host",
        "//agency/nostr",
        "//agency/nostr:relay",
        "//agency/pod",
        "//agency/shared/auth",
        "//agency/shared/journal",
        "//agency/shared/text",
    ],
)

# The root key a scripted lead's spec must verify against, as `auth_spec pubkey` prints it. Fixed
# in the built binary (--//agency/wiring:pinned_root=PUB): no flag or file of the runner's chooses
# it, though a launch command that edits the classpath can (ScriptedLeadRunner's KDoc). Empty by
# default: a binary built without it refuses to start.
string_flag(
    name = "pinned_root",
    build_setting_default = "",
)

pinned_root_jar(
    name = "pinned_root_jar",
    pin = ":pinned_root",
    # ScriptedLeadRunner.PINNED_ROOT_RESOURCE.
    resource_path = "agency/wiring/pinned-root.txt",
)

java_import(
    name = "pinned_root_resource",
    jars = [":pinned_root_jar"],
)

# A ticket lead with no model in it: scripted cognition and fake pods, with real gates announced over
# a relay and approvals taken from it. Run as the lead's OS user, on the lead's host.
java_binary(
    name = "scripted_lead",
    main_class = "com.geekinasuit.agency.wiring.ScriptedLeadRunner",
    runtime_deps = [
        ":pinned_root_resource",
        ":wiring",
        "@maven//:fr_acinq_secp256k1_secp256k1_kmp_jni_jvm",
        "@maven//:org_xerial_sqlite_jdbc",
    ],
)

# The operator's status tool: prints a ticket lead's status from its journal, opened read-only
# beside the running lead. Run as the lead's OS user, on the lead's host.
java_binary(
    name = "lead_status",
    main_class = "com.geekinasuit.agency.wiring.LeadStatusTool",
    runtime_deps = [
        ":wiring",
        "@maven//:fr_acinq_secp256k1_secp256k1_kmp_jni_jvm",
        "@maven//:org_xerial_sqlite_jdbc",
    ],
)

# Over journals one store writes and a signed spec the real signer makes, so it verifies with the
# bip340 verifier (native at runtime) and reads sqlite (at runtime).
kt_jvm_test(
    name = "lead_status_tool_test",
    size = "small",
    srcs = ["LeadStatusToolTest.kt"],
    test_class = "com.geekinasuit.agency.wiring.LeadStatusToolTest",
    runtime_deps = [
        "@maven//:fr_acinq_secp256k1_secp256k1_kmp_jni_jvm",
        "@maven//:org_xerial_sqlite_jdbc",
    ],
    deps = [
        ":wiring",
        "//agency/lead",
        "//agency/nostr",
        "//agency/shared/auth",
        "//agency/shared/journal",
        "@maven//:junit_junit",
        "@maven//:org_jetbrains_kotlinx_kotlinx_serialization_core_jvm",
        "@maven//:org_jetbrains_kotlinx_kotlinx_serialization_json_jvm",
    ],
)

# The runner in-process over scripted relays, with the real signer, verifier and gift wraps (native at
# runtime) and the journal (sqlite at runtime). It carries the pin resource as the binary does, built
# with the default flag, so one cell sees that the default build pins nothing.
kt_jvm_test(
    name = "scripted_lead_runner_test",
    size = "medium",
    srcs = ["ScriptedLeadRunnerTest.kt"],
    associates = [":wiring"],
    test_class = "com.geekinasuit.agency.wiring.ScriptedLeadRunnerTest",
    runtime_deps = [
        ":pinned_root_resource",
        "@maven//:fr_acinq_secp256k1_secp256k1_kmp_jni_jvm",
        "@maven//:org_xerial_sqlite_jdbc",
    ],
    deps = [
        "//agency/lead",
        "//agency/nostr",
        "//agency/nostr:fake_relay",
        "//agency/nostr:relay",
        "//agency/shared/auth",
        "//agency/shared/journal",
        "@maven//:junit_junit",
        "@maven//:org_jetbrains_kotlinx_kotlinx_serialization_json_jvm",
    ],
)

# The operator's authorization-spec tool: prints the root's public key to pin, and signs a spec
# the lead loads. Run where the root key lives, never on the lead's host.
java_binary(
    name = "auth_spec",
    main_class = "com.geekinasuit.agency.wiring.AuthSpecTool",
    runtime_deps = [
        ":wiring",
        "@maven//:fr_acinq_secp256k1_secp256k1_kmp_jni_jvm",
    ],
)

kt_jvm_test(
    name = "auth_spec_tool_test",
    size = "small",
    srcs = ["AuthSpecToolTest.kt"],
    test_class = "com.geekinasuit.agency.wiring.AuthSpecToolTest",
    runtime_deps = ["@maven//:fr_acinq_secp256k1_secp256k1_kmp_jni_jvm"],
    deps = [
        ":wiring",
        "//agency/nostr",
        "//agency/shared/auth",
        "@maven//:junit_junit",
    ],
)

# The approver's tool: reads the lead's gate-open notices and approves one, after the approver types
# back part of its digest. Run where the approver's key lives.
java_binary(

kt_jvm_test(
    name = "permission_bridge_test",
    size = "small",
    srcs = ["PermissionBridgeTest.kt"],
    test_class = "com.geekinasuit.agency.pod.PermissionBridgeTest",
    deps = [
        ":acp_client",
        ":acp_pod_engine",
        ":pod",
        "@maven//:junit_junit",
    ],
)

# The engine battery drives a REAL fake-agent process (data dep below): process-group kill,
# crash/restart with backoff, the pod wall clock, and the artifact refusals all need a
# killable OS child. medium size — the deadline/backoff cells wait on real clocks.
kt_jvm_test(
    name = "acp_pod_engine_test",
    size = "medium",
    srcs = ["AcpPodEngineTest.kt"],
    test_class = "com.geekinasuit.agency.pod.AcpPodEngineTest",
    deps = [
        ":acp_client",
        ":acp_pod_engine",
        ":fake_acp_agent",
        ":pod",
        "@maven//:junit_junit",
    ],
)

# ---- Scheduled real-adapter canary ---------------------------------------------------
#
# Validates the WIRE the deterministic battery cannot (testing honesty): pin coherence
# (code const == package.json == lockfile == installed tree) plus the real adapter's
# initialize handshake through the production ClaudeAdapterProfile. Runs post-merge on a
# schedule — non-gating by placement, telemetry only.
kt_jvm_library(
    name = "pod_canary_lib",
    srcs = ["PodCanary.kt"],
    deps = [
        ":acp_client",
        ":acp_pod_engine",
        ":pod",
        "//agency/shared/harness",
        "@maven//:org_jetbrains_kotlinx_kotlinx_serialization_json_jvm",
    ],
)

java_binary(
    name = "pod_canary",
    main_class = "com.geekinasuit.agency.pod.PodCanary",
    runtime_deps = [":pod_canary_lib"],
)

# The canary's gate logic against the wire-faithful fake: the PASS path pins that the
# pinned SDK negotiates the protocol version the code const claims, and the FAIL paths
# prove version/protocol skew actually trips the gate (a canary that cannot fail is
# telemetry-shaped noise). medium size — the live-lifecycle cell forks a real fake-agent
# subprocess via FakeAgentLauncher and drives a real handshake, same as
# acp_pod_engine_test.
kt_jvm_test(
    name = "pod_canary_core_test",
    size = "medium",
    srcs = ["PodCanaryCoreTest.kt"],
    test_class = "com.geekinasuit.agency.pod.PodCanaryCoreTest",
    deps = [
        ":acp_client",
        ":fake_acp_agent",
        ":pod",
        ":pod_canary_lib",
        "@maven//:junit_junit",
    ],
)

# AGENCY-027 standing guard: the single-family invariant, enforced rather than narrated
# (the ticket's original defect was a rule that lived only in a comment). The genquery
# pins the exact coroutines label set reachable from the CO-LINKING target — tool/implicit
# edges excluded, since kotlinc's own bundled coroutines rides a toolchain edge and is not
# target classpath material — and the diff_test fails CI the moment a second family appears
# (a reintroduced second maven install, a new coroutines dep, or a version move: the
# resolved jar's file label carries the version). Updating the .expected file is then a
# REVIEWED act, exactly like the MODULE.bazel pin it mirrors. genquery emits CANONICAL
# labels (@@rules_jvm_external++maven+maven//...), so the .expected also shifts on a
# rules_jvm_external major move — likewise a reviewed act.
#
# Scoped to acp_pod_engine_test, NOT acp_client_test: the client test
# reaches acp deps alone, while the ENGINE is the target that puts acp deps and ordinary
# substrate libs (//agency/shared/harness) on one classpath — the exact co-linking case
# AGENCY-027 exists for. Pointed at the client test, a second family arriving through the
# harness would not move the query result and CI would stay green.
genquery(
    name = "acp_coroutines_deps",
    expression = "filter(coroutines, deps(//agency/pod:acp_pod_engine_test))",
    opts = [
        "--notool_deps",
        "--noimplicit_deps",
    ],
    scope = [":acp_pod_engine_test"],
)

diff_test(
    name = "acp_single_coroutines_family_test",
    file1 = ":acp_coroutines_deps",
    file2 = "acp_coroutines_deps.expected",
)

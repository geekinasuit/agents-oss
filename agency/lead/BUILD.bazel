# The lead daemon — a model-free durable substrate hosting an event-driven,
# model-bearing cognition loop.
#
# Shape: state = leadFold(journal), never stored — two folds over one entry list
# beside the shared JournalState. Cognition is a strategy the substrate consults
# once per wake and journals with origin=cognition; the substrate is the sole writer and
# sole actor, and nothing cognition outputs can release a gate — releases are honored by
# provenance (auth layer) + digest binding in the folds. Between wakes the loop
# blocks: idle is structural, zero model spend.
#
# Deliberate stubs, each replaced by later work: the AuthStub ceremony (a real
# authorization surface), FakePodRunner (real launcher + resume re-attach), and the
# mailbox surface.
#
# The pod descriptor + engine seam live in //agency/pod (the lead depends on it,
# never the reverse); the daemon holds a required lead-owned PodSpec and
# fence-checks it at the spawn site.
#
# The prompt/render/parse contract is CognitionProtocol.kt, shared by every
# model-backed strategy so provider choice cannot change what counts as a decision.
# CognitionSelection.kt is where a lead picks one, pairing each strategy with the
# per-wake attempt cap that strategy is safe to run under.

# The host: what every agent runs, whatever workflow it runs. It builds without :lead's sources, so a
# host-side reference to ticket code fails to resolve, and :lead depends on it, so adding a dependency
# back would be a cycle. That holds for symbols only, not for ticket knowledge written as strings.
kt_jvm_library(
    name = "host",
    srcs = [
        "AgentHost.kt",
        "ApprovalClassifier.kt",
        "AuthStub.kt",
        "ClaudeCognition.kt",
        "Cognition.kt",
        "CognitionProtocol.kt",
        "DeadlinedReads.kt",
        "EnginePodRunner.kt",
        "GateOpenSink.kt",
        "HostFold.kt",
        "HostKinds.kt",
        "HostRecords.kt",
        "HostSeams.kt",
        "IncrementalLeadView.kt",
        "OpenAiCompatCognition.kt",
        "PayloadReaders.kt",
        "PodSeam.kt",
        "Workflow.kt",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//agency/pod",
        "//agency/pod:acp_client",
        "//agency/pod:acp_pod_engine",
        # The lead fold re-verifies approvals and gates release on a quorum (2a.4 step 2b), so
        # it consumes the verifying vocabulary: allow-list, quorum, and the ApprovalVerifier
        # port + preimage parse. A clean downward edge, like the journal dep.
        "//agency/shared/auth",
        "//agency/shared/harness",
        "//agency/shared/journal",
        # Whether a gate-open artifact has something to read, the rule the notice codec holds too.
        "//agency/shared/text",
        "@maven//:org_jetbrains_kotlinx_kotlinx_serialization_core_jvm",
        "@maven//:org_jetbrains_kotlinx_kotlinx_serialization_json_jvm",
        "@maven//:org_json_json",
    ],
)

# A ticket lead: the ticket workflow on the host. It exports the host, so a target that depends on
# it sees both. associates (not deps alone) on :host, since the workflow implements the host's
# internal contract (Workflow, HostServices, the fold and its records): the two compile as one Kotlin
# module, and that contract stays out of the public API.
kt_jvm_library(
    name = "lead",
    srcs = [
        "CognitionSelection.kt",
        "LeadState.kt",
        "TicketLead.kt",
        "TicketWorkflow.kt",
        "TicketWorkflowProtocol.kt",
    ],
    associates = [":host"],
    visibility = ["//visibility:public"],
    exports = [":host"],
    deps = [
        "//agency/pod",
        "//agency/shared/harness",
        "//agency/shared/journal",
        "@maven//:org_jetbrains_kotlinx_kotlinx_serialization_core_jvm",
        "@maven//:org_jetbrains_kotlinx_kotlinx_serialization_json_jvm",
        "@maven//:org_json_json",
    ],
)


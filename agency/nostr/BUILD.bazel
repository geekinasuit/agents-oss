load("@rules_kotlin//kotlin:jvm.bzl", "kt_jvm_library", "kt_jvm_test")

# The nostr substrate adapter for the 2a.4 authorization gate: the NIP-01 event codec (id +
# sign/verify, plus the JSON wire object and the relay-message envelopes) and the bip340
# realization of the authorization layer's ApprovalVerifier port.
#
# THE DEPENDENCY EDGE POINTS INWARD, by the standing rule: this module depends on
# //agency/shared/auth (it implements auth's port and reads its committed preimage); auth and the
# lead fold NEVER depend on nostr and never see a NIP number, an npub, a relay URL, or any type
# from here. Swapping the substrate means replacing this module, not editing auth.
#
# The :nostr LIBRARY is pure and hermetic — no relay connection, no socket, nothing that binds or
# dials (A4-2). The transport that DOES dial (step 3b) is the separate :relay target below: it
# depends on :nostr and takes the relay URL and the lead key as required configuration (§REPO_SEAM
# keeps those values in coach). Keeping it a distinct target — not extra srcs on :nostr — is what
# keeps the codec itself hermetic; a consumer that wants only the codec never links a socket.
#
# secp256k1: the -jvm coordinate carries the API (compiled against here); the native lives in
# -jni-jvm and rides each CONSUMING TEST as runtime_deps, exactly as agency/crypto documents — a
# target using this library at runtime for signing/verifying must carry the -jni-jvm jar itself or
# it compiles green and dies at first use.

kt_jvm_library(
    name = "nostr",
    srcs = [
        "Bip340.kt",
        "Bip340ApprovalVerifier.kt",
        "GateOpenNotice.kt",
        "Nip44.kt",
        "NostrEvent.kt",
        "NostrWire.kt",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//agency/shared/auth",
        "@maven//:fr_acinq_secp256k1_secp256k1_kmp_jvm",
        # The wire OBJECT is parsed with a vetted JSON library (hand-rolling a parser for hostile
        # relay input would be the liability); the id-preimage in NostrEvent.kt stays hand-rolled.
        # This is the first runtime JSON edge in this module — adopter-visible, like the secp256k1
        # edge above.
        "@maven//:org_jetbrains_kotlinx_kotlinx_serialization_core_jvm",
        "@maven//:org_jetbrains_kotlinx_kotlinx_serialization_json_jvm",
    ],
)

# Hermetic and native-free: the id is sha256 over a hand-rolled NIP-01 serialization, and the
# anchor oracle is kotlinx-serialization (a DIFFERENT serializer), so this cell needs no crypto
# native — only the JSON library to build the independent preimage.
kt_jvm_test(
    name = "event_id_test",
    size = "small",
    srcs = ["EventIdTest.kt"],
    test_class = "com.geekinasuit.agency.nostr.EventIdTest",
    deps = [
        ":nostr",
        "@maven//:junit_junit",
        "@maven//:org_jetbrains_kotlinx_kotlinx_serialization_core_jvm",
        "@maven//:org_jetbrains_kotlinx_kotlinx_serialization_json_jvm",
    ],
)

kt_jvm_test(
    name = "nostr_event_sign_verify_test",
    size = "small",
    srcs = ["NostrEventSignVerifyTest.kt"],
    test_class = "com.geekinasuit.agency.nostr.NostrEventSignVerifyTest",
    # The natives load reflectively from the classpath — runtime-only, like the sqlite JDBC
    # driver in agency/shared/journal and the same split agency/crypto uses.
    runtime_deps = ["@maven//:fr_acinq_secp256k1_secp256k1_kmp_jni_jvm"],
    deps = [
        ":nostr",
        "@maven//:junit_junit",
    ],
)

kt_jvm_test(
    name = "bip340_approval_verifier_test",
    size = "small",
    srcs = ["Bip340ApprovalVerifierTest.kt"],
    test_class = "com.geekinasuit.agency.nostr.Bip340ApprovalVerifierTest",
    runtime_deps = ["@maven//:fr_acinq_secp256k1_secp256k1_kmp_jni_jvm"],
    deps = [
        ":nostr",
        # committedPreimage: the authorization layer's own canonical serialization, the message
        # this verifier re-checks a signature over.
        "//agency/shared/auth",
        "@maven//:junit_junit",
    ],
)

# The production NIP-44 codec, against the spec's own vectors plus the properties the probe could
# not assert (null-not-throw on hostile input, the point-multiply trap, nonce freshness, the
# length ceiling). Unlike every test above it, this one needs the spec's vector file at runtime,
# and $(rlocationpath) expansion in `env` is documented core behavior only for a native
# java_test — so it is a java_test wrapping a kt_jvm_library, the same split agency/crypto uses
# for its probe vectors, rather than the kt_jvm_test its neighbours use. The file is shared from
# //agency/crypto (one copy, one published digest). associates= makes the test a friend of the
# codec's module so it can reach the internal seams the vectors need — the nonce-injecting
# encrypt, the intermediate key schedule, the padding rule, and the module's Hex codec.
kt_jvm_library(
    name = "nip44_test_lib",
    testonly = True,
    srcs = ["Nip44Test.kt"],
    associates = [":nostr"],
    deps = [
        "@maven//:fr_acinq_secp256k1_secp256k1_kmp_jvm",
        "@maven//:junit_junit",
        "@maven//:org_json_json",
    ],
)

java_test(
    name = "nip44_test",
    size = "small",
    data = ["//agency/crypto:testdata/nip44.vectors.json"],
    env = {"NIP44_VECTORS": "$(rlocationpath //agency/crypto:testdata/nip44.vectors.json)"},
    test_class = "com.geekinasuit.agency.nostr.Nip44Test",
    runtime_deps = [
        ":nip44_test_lib",
        # The natives load reflectively from the classpath — runtime-only, like the sign/verify
        # test above and the sqlite JDBC driver in agency/shared/journal.
        "@maven//:fr_acinq_secp256k1_secp256k1_kmp_jni_jvm",
    ],
)

# The wire codec, native-free: serialization, TOTAL parsing of hostile relay JSON, and the
# relay-message envelopes. Like event_id_test it needs only the JSON library and no crypto native —
# parsing structures bytes and makes no signature check.
kt_jvm_test(
    name = "nostr_wire_test",
    size = "small",
    srcs = ["NostrWireTest.kt"],
    test_class = "com.geekinasuit.agency.nostr.NostrWireTest",
    deps = [
        ":nostr",
        "@maven//:junit_junit",
        "@maven//:org_jetbrains_kotlinx_kotlinx_serialization_json_jvm",
    ],
)

# The wire codec over the real BIP-340 primitive: the NIP-42 auth event, a signed event surviving
# the round-trip with its signature intact, and the full client AUTH path (frame -> unwrap ->
# verify). Needs the native runtime-only, like the sign/verify test; it also reads JSON directly
# (kotlinx) to unwrap the ["AUTH", <event>] envelope it frames — parseRelayMessage handles only the
# inbound ["AUTH", <challenge>] shape — so it carries the JSON dep like nostr_wire_test does.
kt_jvm_test(
    name = "nostr_wire_sign_test",
    size = "small",
    srcs = ["NostrWireSignTest.kt"],
    test_class = "com.geekinasuit.agency.nostr.NostrWireSignTest",
    runtime_deps = ["@maven//:fr_acinq_secp256k1_secp256k1_kmp_jni_jvm"],
    deps = [
        ":nostr",
        "@maven//:junit_junit",
        "@maven//:org_jetbrains_kotlinx_kotlinx_serialization_json_jvm",
    ],
)

# The relay TRANSPORT (step 3b): the socket that carries the wire format above. Kept out of :nostr
# so the codec stays pure — this is the target that dials. It depends ONLY on :nostr's public
# String-based API (it scans the raw text for JSON nesting depth and hands the text to parseRelayMessage),
# so it carries NO JSON dependency of its own; and it is built on the JDK's java.net.http.WebSocket,
# so it adds no @maven dependency at all. The lead key rides in as configuration — the -jni native
# is a runtime dep of the CONSUMING test that signs, not of this library.
kt_jvm_library(
    name = "relay",
    srcs = [
        "RelayConnection.kt",
        # The gate-open notifier (step 4): fans the notice codec out over a recipient set and
        # publishes each via RelayConnection. Lives here, with the target that dials, because it
        # publishes; the codec itself is hermetic and stays in :nostr.
        "RelayNotifier.kt",
    ],
    visibility = ["//visibility:public"],
    deps = [":nostr"],
)

# The fake relay test double: a raw-socket RFC-6455 SERVER (the JDK ships a WebSocket client but no
# server), testonly, reused by the transport tests here and the hostile-relay cases in 3b-2. It
# depends on nothing — the handshake, framing, and client-frame unmasking are all hand-rolled.
kt_jvm_library(
    name = "fake_relay",
    testonly = True,
    srcs = ["FakeRelay.kt"],
    visibility = ["//visibility:private"],
)

# The transport's structural cells, native-free: connect-failure classification, fragment
# reassembly, ping-survival, and the three ingress bounds (size, JSON-nesting depth, queued-message
# count). Like nostr_wire_test it makes no signature check, so it needs no crypto native. The bound
# cells push ~1 MiB and a message flood through a loopback socket, which is still milliseconds.
kt_jvm_test(
    name = "relay_connection_test",
    size = "small",
    srcs = ["RelayConnectionTest.kt"],
    test_class = "com.geekinasuit.agency.nostr.RelayConnectionTest",
    deps = [
        ":fake_relay",
        ":nostr",
        ":relay",
        "@maven//:junit_junit",
    ],
)

# The subscription transport (step 3b-2): subscribe()/closeSubscription() framing and round-trip, and
# the A4-3 hostile-relay matrix (withheld, reordered, delayed, replayed) proving the transport is a
# faithful pipe. Native-free like relay_connection_test — the events it delivers are structural
# literals the transport never verifies, so it needs no crypto native and no JSON dep of its own (it
# frames server messages with :nostr's serialize()).
kt_jvm_test(
    name = "relay_connection_subscribe_test",
    size = "small",
    srcs = ["RelayConnectionSubscribeTest.kt"],
    test_class = "com.geekinasuit.agency.nostr.RelayConnectionSubscribeTest",
    deps = [
        ":fake_relay",
        ":nostr",
        ":relay",
        "@maven//:junit_junit",
    ],
)

# The NIP-42 auth handshake over the real BIP-340 primitive: the client signs a kind-22242 event and
# the relay verdicts on it. Needs the native runtime-only, like nostr_wire_sign_test, because it
# signs; and reads JSON directly (kotlinx) to pull the client event's id out of the ["AUTH", <event>]
# frame the fake relay receives.
kt_jvm_test(
    name = "relay_connection_auth_test",
    size = "small",
    srcs = ["RelayConnectionAuthTest.kt"],
    test_class = "com.geekinasuit.agency.nostr.RelayConnectionAuthTest",
    runtime_deps = ["@maven//:fr_acinq_secp256k1_secp256k1_kmp_jni_jvm"],
    deps = [
        ":fake_relay",
        ":nostr",
        ":relay",
        "@maven//:junit_junit",
        "@maven//:org_jetbrains_kotlinx_kotlinx_serialization_json_jvm",
    ],
)

# Step 4 — the gate-open NOTICE codec (A4-6): encode a content-minimal notice as a lead-signed,
# NIP-44-encrypted, regular-kind event addressed to one recipient. Signs and encrypts, so it needs
# the native runtime-only, like the sign/verify test; it parses the decrypted plaintext with kotlinx
# to assert the round-trip, so it carries the JSON dep as nostr_wire_test does.
kt_jvm_test(
    name = "gate_open_notice_test",
    size = "small",
    srcs = ["GateOpenNoticeTest.kt"],
    test_class = "com.geekinasuit.agency.nostr.GateOpenNoticeTest",
    runtime_deps = ["@maven//:fr_acinq_secp256k1_secp256k1_kmp_jni_jvm"],
    deps = [
        ":nostr",
        "@maven//:junit_junit",
        "@maven//:org_jetbrains_kotlinx_kotlinx_serialization_json_jvm",
    ],
)

# Step 4 — "listening never authorizes" (A4-6), made executable over the REAL verifier + allow-list +
# quorum: a command-shaped event signed by an allow-listed key verifies as a transport carrier yet
# releases nothing, because its transport signature is not an authorization over the committed
# preimage. Depends on the auth module for the fold's pieces (AllowList, committedPreimage, the
# quorum) and signs, so it carries the native runtime-only — the bip340_approval_verifier_test shape.
kt_jvm_test(
    name = "listening_never_authorizes_test",
    size = "small",
    srcs = ["ListeningNeverAuthorizesTest.kt"],
    test_class = "com.geekinasuit.agency.nostr.ListeningNeverAuthorizesTest",
    runtime_deps = ["@maven//:fr_acinq_secp256k1_secp256k1_kmp_jni_jvm"],
    deps = [
        ":nostr",
        "//agency/shared/auth",
        "@maven//:junit_junit",
    ],
)

# Step 4 — the relay-backed notifier's fan-out over a recipient SET: dedup of case-variant keys,
# fail-closed on an empty set, per-recipient outcomes (partial delivery = liveness gap), the oversize
# refusal surfaced as NotEncodable, and the crypto-before-deadline phase order (#45). Tests through a
# fake EventPublisher — no socket — but signs in the crypto phase, so it needs the native
# runtime-only.
kt_jvm_test(
    name = "relay_notifier_test",
    size = "small",
    srcs = ["RelayNotifierTest.kt"],
    test_class = "com.geekinasuit.agency.nostr.RelayNotifierTest",
    runtime_deps = ["@maven//:fr_acinq_secp256k1_secp256k1_kmp_jni_jvm"],
    deps = [
        ":nostr",
        ":relay",
        "@maven//:junit_junit",
    ],
)
